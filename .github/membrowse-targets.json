{
  "setup_cmd": "curl -fsSL https://raw.githubusercontent.com/arduino/arduino-cli/master/install.sh | sudo BINDIR=/usr/local/bin sh && arduino-cli core install ch32-community:ch32v --additional-urls https://github.com/ch32-community/board_manager_files/raw/main/package_ch32v_index.json",
  "examples": [
    "libraries/EEPROM/examples/eeprom_counter",
    "libraries/EEPROM/examples/eeprom_crc",
    "libraries/EEPROM/examples/eeprom_get",
    "libraries/EEPROM/examples/eeprom_put",
    "libraries/EEPROM/examples/eeprom_read",
    "libraries/EEPROM/examples/eeprom_write",
    "libraries/SPI/examples/SPIFlash",
    "libraries/USBPD_SINK/examples/usbpd_sink_request_voltage",
    "libraries/Wire/examples/at24c02_read_write",
    "libraries/Wire/examples/i2cMinimalSlave",
    "libraries/Wire/examples/i2c_scanner",

    "ci/libraries/DefaultBlinkyTest/DefaultBlinkyTest.ino"
  ],
  "mcus": [
    {
      "name": "ch32v00x",
      "fqbn": "ch32-community:ch32v:CH32V00x_EVT:dbg=enable_sym",
      "build_dir": "build/CH32V00x",
      "ld": "system/CH32V00x/SRC/Ld/Link.ld",
      "linker_vars": "__FLASH_SIZE=16384 __RAM_SIZE=2048",
      "skip_keys": ["CH32V00x"]
    },
    {
      "name": "ch32vm00x-v002",
      "fqbn": "ch32-community:ch32v:CH32VM00X_EVT:pnum=CH32V002F4,dbg=enable_sym",
      "build_dir": "build/CH32VM00X_002",
      "ld": "system/CH32VM00X/SRC/Ld/LinkV002.ld",
      "linker_vars": "__FLASH_SIZE=16384 __RAM_SIZE=4096",
      "skip_keys": ["CH32VM00X", "CH32VM00X-CH32V002F4"]
    },
    {
      "name": "ch32vm00x-v006",
      "fqbn": "ch32-community:ch32v:CH32VM00X_EVT:pnum=CH32V006K8,dbg=enable_sym",
      "build_dir": "build/CH32VM00X_006",
      "ld": "system/CH32VM00X/SRC/Ld/Link.ld",
      "linker_vars": "__FLASH_SIZE=63488 __RAM_SIZE=8192",
      "skip_keys": ["CH32VM00X", "CH32VM00X-CH32V006K8"]
    },
    {
      "name": "ch32l10x",
      "fqbn": "ch32-community:ch32v:CH32L10x_EVT:dbg=enable_sym",
      "build_dir": "build/CH32L10x",
      "ld": "system/CH32L10x/SRC/Ld/Link.ld",
      "linker_vars": "__FLASH_SIZE=65536 __RAM_SIZE=20480",
      "skip_keys": ["CH32L10x"]
    },
    {
      "name": "ch32v10x",
      "fqbn": "ch32-community:ch32v:CH32V10x_EVT:dbg=enable_sym",
      "build_dir": "build/CH32V10x",
      "ld": "system/CH32V10x/SRC/Ld/Link.ld",
      "linker_vars": "__FLASH_SIZE=65536 __RAM_SIZE=20480",
      "skip_keys": ["CH32V10x"]
    },
    {
      "name": "ch32v20x",
      "fqbn": "ch32-community:ch32v:CH32V20x_EVT:dbg=enable_sym",
      "build_dir": "build/CH32V20x",
      "ld": "system/CH32V20x/SRC/Ld/Link.ld",
      "linker_vars": "__FLASH_SIZE=131072 __RAM_SIZE=65536",
      "skip_keys": ["CH32V20x"]
    },
    {
      "name": "ch32v30x",
      "fqbn": "ch32-community:ch32v:CH32V30x_EVT:dbg=enable_sym",
      "build_dir": "build/CH32V30x",
      "ld": "system/CH32V30x/SRC/Ld/Link.ld",
      "linker_vars": "__FLASH_SIZE=262144 __RAM_SIZE=65536",
      "skip_keys": ["CH32V30x"]
    },
    {
      "name": "ch32x035",
      "fqbn": "ch32-community:ch32v:CH32X035_EVT:dbg=enable_sym",
      "build_dir": "build/CH32X035",
      "ld": "system/CH32X035/SRC/Ld/Link.ld",
      "linker_vars": "__FLASH_SIZE=63488 __RAM_SIZE=20480",
      "skip_keys": ["CH32X035"]
    }
  ]
}
